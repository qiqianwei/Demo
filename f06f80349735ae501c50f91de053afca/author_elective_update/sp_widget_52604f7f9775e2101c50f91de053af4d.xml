        <script><![CDATA[(function() {
  // 处理客户端请求
  if (input && input.action === 'generatePDF') {
    var response = {
      status: 'error',
      message: '',
      downloadUrl: ''
    };
    
    try {
      var sysId = input.sys_id;
      var tableName = input.table;
      
      // 验证输入
      if (!sysId || !tableName) {
        response.message = '缺少必要参数';
        return response;
      }
      
      // 检查记录是否存在
      var gr = new GlideRecord(tableName);
      if (!gr.get(sysId)) {
        response.message = '记录不存在';
        return response;
      }
      
      // 生成PDF
      var renderer = new PDFRenderer();
      var options = {
        table: tableName,
        sys_id: sysId,
        filename: 'document_' + gr.number + '.pdf',
        template: 'your_template_id' // 可选，使用你的PDF模板ID
      };
      
      var pdf = renderer.render(options);
      if (pdf) {
        // 创建临时附件
        var attachment = new GlideSysAttachment();
        var attachmentSysId = attachment.write(pdf, tableName, sysId, options.filename, 'application/pdf');
        
        // 标记为临时附件（可选）
        new global.TempAttachmentUtil().markForDeletion(attachmentSysId);
        
        response.downloadUrl = '/sys_attachment.do?sys_id=' + attachmentSysId;
        response.status = 'success';
      } else {
        response.message = 'PDF生成失败';
      }
    } catch (e) {
      response.message = '服务器错误: ' + e.message;
      gs.error('PDF生成错误: ' + e.message);
    }
    
    return response;
  }
  
  // 初始化代码（可选）
  // data.table = $sp.getParameter('table') || 'incident'; // 示例：从URL参数获取表名
})();
]]></script>
