        <name>Set Assigner to Current  User</name>
        <onclick>openModal()</onclick>
        <order>100</order>
        <script><![CDATA[function openModal() {
    var gm = new GlideModal("glide_confirm_basic", false, 400);
    gm.setTitle("Set Assigner to Current User");
    gm.setPreference("title", "<p>This operation will set assigner to current user. Do you still want to do it ?</p>");
    gm.setPreference('onPromptComplete', setAssigner);
    gm.render();

    function setAssigner() {
        var ga = new GlideAjax('SetAssigner');
        ga.addParam('sysparm_name', 'setData');
        ga.getXMLAnswer(handleResponse);
    }

    function handleResponse(response) {
        var result = JSON.parse(response);
        g_form.setValue('assigner', result.userID);
    }
}]]></script>
